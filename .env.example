# URL server backend NestJS (hanya diakses di sisi server, tanpa /api, tanpa prefix NEXT_PUBLIC)
API_BASE_URL=http://localhost:3002

# URL server mock json-server (digunakan saat data source disetel ke mock)
MOCK_API_BASE_URL=http://localhost:4000

# Origin frontend (digunakan untuk validasi Same-Origin pada route handler Next.js)
APP_ORIGIN=http://localhost:3000

# Konfigurasi Reverse Proxy / Header IP Klien (Opsional, Default Aman: Kosong)
# TRUSTED_IP_HEADER: Header khusus dari reverse proxy tepercaya (misal: x-real-ip, cf-connecting-ip, x-vercel-forwarded-for)
# TRUSTED_IP_HEADER=

# TRUSTED_PROXY_HOPS: Jumlah hop proxy tepercaya pada X-Forwarded-For (dihitung dari kanan). Digunakan jika TRUSTED_IP_HEADER tidak diisi.
# TRUSTED_PROXY_HOPS=0

# Hostname Supabase Storage untuk next/image remotePatterns (tanpa https://)
SUPABASE_IMAGE_HOST=your-project.supabase.co
